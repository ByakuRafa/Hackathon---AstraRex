[sub_resource type="Shader" id="Shader_vab_grid"]
code = "shader_type spatial;
render_mode cull_back, specular_schlick_ggx;

uniform vec4 base_color : source_color = vec4(0.045, 0.062, 0.095, 1.0);
uniform vec4 grid_color : source_color = vec4(0.16, 0.42, 0.65, 1.0);
uniform float grid_scale = 40.0;

void fragment() {
	vec2 uv_scaled = UV * grid_scale;
	vec2 f = abs(fract(uv_scaled - 0.5) - 0.5);
	float line = 1.0 - smoothstep(0.015, 0.04, min(f.x, f.y));
	float radial = 1.0 - smoothstep(0.25, 0.5, length(UV - vec2(0.5)));
	ALBEDO = mix(base_color.rgb, grid_color.rgb, line * radial * 0.75);
	ROUGHNESS = 0.75;
	METALLIC = 0.25;
}
"

